{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}}
 ;; reagent/re-frame are ClojureScript view/state libraries compiled into the
 ;; browser bundle by shadow-cljs — not a new top-level JVM runtime
 ;; dependency (ADR-2608201300 cutover). Scoped under :cljs, the alias
 ;; shadow-cljs.edn's `:deps {:aliases [:cljs :test]}` already pulls in.
 :aliases {:cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
